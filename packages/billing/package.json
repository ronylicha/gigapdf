{
  "name": "@giga-pdf/billing",
  "license": "PolyForm-Noncommercial-1.0.0",
  "version": "0.1.0",
  "description": "Stripe billing integration for GigaPDF",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
